{
  "name": "n8n-nodes-mbxflow",
  "version": "0.1.1",
  "description": "MBX Flow nodes for n8n: save drafts, schedule posts to your connected social accounts, and start a workflow when a post is published or fails.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "mbxflow",
    "mbx flow",
    "social media",
    "scheduling"
  ],
  "license": "MIT",
  "homepage": "https://mbxflow.com/developers/api",
  "author": {
    "name": "MediaBoxEnt Technologies",
    "email": "hello@mediaboxent.tech"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MediaBoxEnt-Technologies/n8n-nodes-mbxflow.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "node scripts/clean.js && tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\"",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MbxFlowApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MbxFlow/MbxFlow.node.js",
      "dist/nodes/MbxFlowTrigger/MbxFlowTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.49.1",
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.3"
  },
  "bugs": {
    "url": "https://github.com/MediaBoxEnt-Technologies/n8n-nodes-mbxflow/issues",
    "email": "support@mbxflow.com"
  }
}
